@using System.Globalization
@using MYAcademy_IdentityEmail.Entities
@model List<Message>
@{
    Layout = null;
    var tr = new CultureInfo("tr-TR");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gelen Kutusu — Postane</title>

    <!-- Yazı tipi: Inter (Türkçe karakter desteği için latin-ext dahil) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 ve Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        /* =========================================================
           1. TEMA DEĞİŞKENLERİ
           ========================================================= */
        :root {
            --app-bg: #F6F4EF;
            --surface: #FFFFFF;
            --surface-soft: #FBFAF7;
            --sidebar-bg: #EFEBE3;

            --border: #E3DED3;
            --border-soft: #EEEAE2;

            --text: #2A2925;
            --text-2: #4F4C45;
            --text-muted: #8A857B;

            --sage: #9DBBA4;
            --sage-strong: #4D7A5B;
            --sage-hover: #436C50;
            --sage-soft: #E1ECE3;
            --sage-tint: #F1F6F2;

            --peach: #F0C9AE;
            --peach-strong: #B2643A;
            --peach-soft: #FBEADF;

            --label-work-bg: #E1ECE3; --label-work-text: #44704F;
            --label-personal-bg: #FBE6D8; --label-personal-text: #A65A32;
            --label-important-bg: #F5DCD6; --label-important-text: #9E4638;
            --label-invoice-bg: #F3E8C9; --label-invoice-text: #866A22;
            --label-support-bg: #DFE7EA; --label-support-text: #4B6672;

            --sidebar-width: 264px;
            --navbar-height: 64px;
            --radius: 8px;
            --radius-sm: 6px;
        }

        /* =========================================================
           2. GENEL
           ========================================================= */
        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
            font-size: 14px;
            color: var(--text);
            background: var(--app-bg);
            -webkit-font-smoothing: antialiased;
        }

        a { color: inherit; text-decoration: none; }

        .form-check-input {
            border-color: #C9C3B7;
            cursor: pointer;
        }
        .form-check-input:checked,
        .form-check-input:indeterminate {
            background-color: var(--sage-strong);
            border-color: var(--sage-strong);
        }
        .form-check-input:focus {
            border-color: var(--sage);
            box-shadow: 0 0 0 3px rgba(77, 122, 91, .15);
        }

        .icon-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            padding: 0;
            border: 0;
            border-radius: var(--radius-sm);
            background: transparent;
            color: var(--text-2);
            font-size: 17px;
            position: relative;
            transition: background-color .15s, color .15s;
        }
        .icon-btn:hover { background: var(--border-soft); color: var(--text); }
        .icon-btn:focus-visible { outline: 2px solid var(--sage); outline-offset: 1px; }

        /* =========================================================
           3. SIDEBAR
           ========================================================= */
        .app-sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: var(--sidebar-width);
            display: flex;
            flex-direction: column;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            z-index: 1040;
            transition: transform .2s ease;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            height: var(--navbar-height);
            padding: 0 22px;
        }
        .sidebar-brand-name {
            font-size: 17px;
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.1;
        }
        .sidebar-brand-tagline {
            display: block;
            font-size: 11px;
            font-weight: 500;
            color: var(--text-muted);
            letter-spacing: 0;
        }

        .sidebar-compose {
            padding: 6px 18px 18px;
        }
        .btn-compose {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            height: 40px;
            border: 0;
            border-radius: var(--radius);
            background: var(--sage-strong);
            color: #fff;
            font-weight: 600;
            font-size: 14px;
            transition: background-color .15s;
        }
        .btn-compose:hover { background: var(--sage-hover); color: #fff; }

        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            padding: 0 12px 16px;
        }

        .sidebar-heading {
            margin: 18px 10px 6px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--text-muted);
        }
        .sidebar-heading:first-child { margin-top: 4px; }

        .sidebar-menu {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            height: 36px;
            padding: 0 10px;
            margin-bottom: 1px;
            border-radius: var(--radius-sm);
            color: var(--text-2);
            font-weight: 500;
            transition: background-color .15s, color .15s;
        }
        .sidebar-link i {
            font-size: 16px;
            width: 18px;
            text-align: center;
            color: var(--text-muted);
        }
        .sidebar-link:hover {
            background: rgba(255, 255, 255, .55);
            color: var(--text);
        }
        .sidebar-link.active {
            background: var(--sage-soft);
            color: var(--sage-strong);
            font-weight: 600;
        }
        .sidebar-link.active i { color: var(--sage-strong); }

        .sidebar-count {
            margin-left: auto;
            min-width: 22px;
            padding: 1px 7px;
            border-radius: 10px;
            background: rgba(255, 255, 255, .7);
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 600;
            text-align: center;
        }
        .sidebar-link.active .sidebar-count {
            background: var(--sage-strong);
            color: #fff;
        }

        .sidebar-link .tag-work { color: #6E9B79; }
        .sidebar-link .tag-personal { color: #D69469; }
        .sidebar-link .tag-important { color: #C77565; }

        .sidebar-storage {
            padding: 16px 22px 20px;
            border-top: 1px solid var(--border);
        }
        .storage-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-2);
        }
        .storage-bar {
            height: 5px;
            border-radius: 3px;
            background: #DDD7CB;
            overflow: hidden;
        }
        .storage-bar span {
            display: block;
            height: 100%;
            background: var(--sage-strong);
            border-radius: 3px;
        }
        .storage-text {
            margin-top: 8px;
            font-size: 12px;
            color: var(--text-muted);
        }

        .sidebar-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(42, 41, 37, .35);
            z-index: 1035;
        }

        /* =========================================================
           4. ANA ALAN VE NAVBAR
           ========================================================= */
        .app-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left .2s ease;
        }

        body.sidebar-collapsed .app-sidebar { transform: translateX(-100%); }
        body.sidebar-collapsed .app-main { margin-left: 0; }

        .app-navbar {
            position: sticky;
            top: 0;
            z-index: 1020;
            display: flex;
            align-items: center;
            gap: 16px;
            height: var(--navbar-height);
            padding: 0 28px 0 20px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
        }

        .navbar-search {
            position: relative;
            flex: 0 1 420px;
        }
        .navbar-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 14px;
        }
        .navbar-search input {
            width: 100%;
            height: 38px;
            padding: 0 12px 0 36px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--surface-soft);
            font-size: 14px;
            color: var(--text);
            transition: border-color .15s, background-color .15s;
        }
        .navbar-search input::placeholder { color: var(--text-muted); }
        .navbar-search input:focus {
            outline: none;
            border-color: var(--sage);
            background: var(--surface);
        }

        .navbar-actions {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-left: auto;
        }

        .notify-dot {
            position: absolute;
            top: 8px;
            right: 9px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--peach-strong);
            border: 2px solid var(--surface);
            box-sizing: content-box;
        }

        .navbar-divider {
            width: 1px;
            height: 28px;
            margin: 0 10px;
            background: var(--border);
        }

        .user-toggle {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 8px 4px 4px;
            border: 0;
            border-radius: var(--radius);
            background: transparent;
            text-align: left;
            transition: background-color .15s;
        }
        .user-toggle:hover,
        .user-toggle[aria-expanded="true"] { background: var(--border-soft); }
        .user-toggle::after { display: none; }

        .user-avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--peach-soft);
            color: var(--peach-strong);
            font-size: 13px;
            font-weight: 600;
            flex-shrink: 0;
        }
        .user-name {
            display: block;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.25;
        }
        .user-email {
            display: block;
            font-size: 12px;
            color: var(--text-muted);
            line-height: 1.25;
        }
        .user-toggle .bi-chevron-down {
            font-size: 11px;
            color: var(--text-muted);
        }

        .dropdown-menu {
            min-width: 220px;
            padding: 6px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: 0 8px 24px rgba(42, 41, 37, .08);
            font-size: 14px;
        }
        .dropdown-header-user {
            padding: 8px 10px 10px;
            border-bottom: 1px solid var(--border-soft);
            margin-bottom: 6px;
        }
        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            color: var(--text-2);
        }
        .dropdown-item i { color: var(--text-muted); }
        .dropdown-item:hover,
        .dropdown-item:focus { background: var(--sage-tint); color: var(--text); }
        .dropdown-item.item-logout,
        .dropdown-item.item-logout i { color: #9E4638; }
        .dropdown-divider { border-color: var(--border-soft); margin: 6px 0; }

        /* =========================================================
           5. GELEN KUTUSU
           ========================================================= */
        .inbox-container {
            flex: 1;
            width: 100%;
            padding: 28px 32px 40px;
        }

        .inbox-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 20px;
        }
        .inbox-title {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.02em;
        }
        .inbox-stat {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 3px 9px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--surface);
            font-size: 12px;
            font-weight: 500;
            color: var(--text-2);
            letter-spacing: 0;
        }
        .inbox-stat.is-unread {
            border-color: transparent;
            background: var(--sage-soft);
            color: var(--sage-strong);
        }
        .inbox-stat.is-unread::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--sage-strong);
        }
        .inbox-subtitle {
            margin: 4px 0 0;
            color: var(--text-muted);
        }
        .inbox-updated {
            font-size: 12px;
            color: var(--text-muted);
            white-space: nowrap;
        }

        .inbox-filter-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }
        .inbox-filters {
            display: flex;
            gap: 4px;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .inbox-filters::-webkit-scrollbar { display: none; }

        .inbox-filter {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 12px 11px;
            margin-bottom: -1px;
            border: 0;
            border-bottom: 2px solid transparent;
            background: transparent;
            color: var(--text-muted);
            font-size: 14px;
            font-weight: 500;
            white-space: nowrap;
            transition: color .15s, border-color .15s;
        }
        .inbox-filter:hover { color: var(--text); }
        .inbox-filter.active {
            color: var(--sage-strong);
            border-bottom-color: var(--sage-strong);
            font-weight: 600;
        }
        .filter-count {
            padding: 0 6px;
            border-radius: 4px;
            background: var(--border-soft);
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 600;
            line-height: 18px;
        }
        .inbox-filter.active .filter-count {
            background: var(--sage-soft);
            color: var(--sage-strong);
        }

        .inbox-search {
            position: relative;
            flex: 0 0 280px;
            margin-bottom: 8px;
        }
        .inbox-search i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }
        .inbox-search input {
            width: 100%;
            height: 34px;
            padding: 0 12px 0 32px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--surface);
            font-size: 13px;
            color: var(--text);
        }
        .inbox-search input::placeholder { color: var(--text-muted); }
        .inbox-search input:focus { outline: none; border-color: var(--sage); }

        .inbox-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
        }

        .inbox-toolbar {
            display: flex;
            align-items: center;
            gap: 4px;
            height: 48px;
            padding: 0 12px 0 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface-soft);
        }
        .inbox-toolbar .form-check-input { margin: 0 10px 0 0; }
        .toolbar-divider {
            width: 1px;
            height: 20px;
            margin: 0 6px;
            background: var(--border);
        }
        .inbox-toolbar .icon-btn {
            width: 32px;
            height: 32px;
            font-size: 15px;
        }
        .bulk-action { opacity: .45; }
        .inbox-toolbar.has-selection .bulk-action { opacity: 1; }

        .selection-info {
            margin-left: 8px;
            font-size: 13px;
            font-weight: 500;
            color: var(--sage-strong);
        }
        .toolbar-pagination {
            display: flex;
            align-items: center;
            gap: 2px;
            margin-left: auto;
            font-size: 12px;
            color: var(--text-muted);
        }
        .toolbar-pagination span { margin-right: 6px; white-space: nowrap; }
        .toolbar-pagination .icon-btn:disabled { opacity: .35; pointer-events: none; }

        .is-spinning i { animation: spin .6s linear; }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* =========================================================
           6. E-POSTA SATIRI
           ========================================================= */
        .mail-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .mail-item {
            position: relative;
            display: grid;
            grid-template-columns: 18px 34px minmax(120px, 190px) minmax(0, 1fr) auto;
            grid-template-areas: "check avatar sender body meta";
            align-items: center;
            column-gap: 14px;
            padding: 13px 20px;
            border-bottom: 1px solid var(--border-soft);
            background: var(--surface);
            transition: background-color .12s;
        }
        .mail-item:last-child { border-bottom: 0; }
        .mail-item[hidden] { display: none; }
        .mail-item:hover { background: #FAF8F4; }
        .mail-item.is-selected { background: var(--sage-tint); }

        .mail-item[data-read="false"]::before {
            content: "";
            position: absolute;
            left: 0;
            top: 10px;
            bottom: 10px;
            width: 3px;
            border-radius: 0 2px 2px 0;
            background: var(--sage-strong);
        }

        .mail-select { grid-area: check; display: flex; }
        .mail-select .form-check-input { margin: 0; }

        .mail-avatar {
            grid-area: avatar;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            font-size: 12px;
            font-weight: 600;
            background: #E1ECE3;
            color: #44704F;
        }

        .mail-sender {
            grid-area: sender;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            font-weight: 500;
            color: var(--text-2);
        }

        .mail-body {
            grid-area: body;
            display: flex;
            align-items: baseline;
            gap: 8px;
            min-width: 0;
            color: var(--text-2);
        }
        .mail-subject {
            flex-shrink: 0;
            max-width: 55%;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
        .mail-preview {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            color: var(--text-muted);
        }
        .mail-preview::before {
            content: "—";
            margin-right: 8px;
            color: #CFC9BD;
        }

        .mail-item[data-read="false"] .mail-sender,
        .mail-item[data-read="false"] .mail-subject {
            font-weight: 600;
            color: var(--text);
        }

        .mail-meta {
            grid-area: meta;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .mail-date {
            text-align: right;
            font-size: 12px;
            color: var(--text-muted);
            white-space: nowrap;
        }
        .mail-item[data-read="false"] .mail-date {
            color: var(--text);
            font-weight: 600;
        }

        .mail-empty {
            padding: 56px 20px;
            text-align: center;
            color: var(--text-muted);
        }
        .mail-empty i {
            display: block;
            margin-bottom: 10px;
            font-size: 28px;
            color: #CFC9BD;
        }
        .mail-empty strong {
            display: block;
            margin-bottom: 2px;
            color: var(--text-2);
            font-weight: 600;
        }

        .inbox-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 20px;
            border-top: 1px solid var(--border);
            background: var(--surface-soft);
            font-size: 12px;
            color: var(--text-muted);
        }

        .modal-content {
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: 0 12px 32px rgba(42, 41, 37, .12);
        }
        .modal-title { font-size: 16px; font-weight: 600; }
        .btn-app {
            height: 36px;
            padding: 0 16px;
            border-radius: var(--radius-sm);
            font-size: 14px;
            font-weight: 500;
        }
        .btn-app-light {
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text-2);
        }
        .btn-app-light:hover { background: var(--border-soft); }
        .btn-app-danger {
            border: 0;
            background: #B45343;
            color: #fff;
        }
        .btn-app-danger:hover { background: #9E4638; color: #fff; }

        .app-toast {
            border: 0;
            border-radius: var(--radius);
            background: var(--text);
            color: #fff;
            font-size: 13px;
        }

        .tooltip { --bs-tooltip-bg: var(--text); --bs-tooltip-font-size: 12px; }

        /* =========================================================
           7. RESPONSIVE
           ========================================================= */
        @@media (max-width: 991.98px) {
            .app-sidebar { transform: translateX(-100%); }
            .app-main { margin-left: 0; }
            body.sidebar-open .app-sidebar { transform: none; }
            body.sidebar-open .sidebar-backdrop { display: block; }

            .inbox-container { padding: 24px 20px 32px; }
            .inbox-updated { display: none; }
            .mail-preview { display: none; }
            .mail-subject { max-width: none; flex: 1; }
        }

        @@media (max-width: 767.98px) {
            .app-navbar { padding: 0 12px; gap: 8px; }
            .navbar-search { display: none; }
            .navbar-divider { display: none; }

            .inbox-filter-bar {
                flex-direction: column;
                align-items: stretch;
                gap: 8px;
                border-bottom: 0;
            }
            .inbox-filters { border-bottom: 1px solid var(--border); }
            .inbox-search { flex: none; margin-bottom: 0; }

            .inbox-toolbar { padding: 0 8px 0 14px; }
            .toolbar-pagination span { display: none; }

            .mail-item {
                grid-template-columns: 18px 34px minmax(0, 1fr) auto;
                grid-template-areas:
                    "check avatar sender meta"
                    "check avatar body body";
                row-gap: 3px;
                column-gap: 12px;
                padding: 12px 14px;
                align-items: start;
            }
            .mail-select, .mail-avatar { align-self: center; }

            .mail-body { display: block; }
            .mail-subject,
            .mail-preview {
                display: block;
                max-width: 100%;
            }
            .mail-preview::before { display: none; }
            .mail-preview { font-size: 13px; margin-top: 1px; }

            .inbox-footer { padding: 12px 14px; }
        }
    </style>
</head>
<body>

    <aside class="app-sidebar" id="appSidebar">
        <div class="sidebar-brand">
            <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
                <rect width="32" height="32" rx="8" fill="#4D7A5B"/>
                <rect x="7.5" y="10" width="17" height="12.5" rx="2" fill="none" stroke="#FFFFFF" stroke-width="1.8"/>
                <path d="M8.5 11.5 L16 17 L23.5 11.5" fill="none" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="24.5" cy="9.5" r="3.5" fill="#F0C9AE" stroke="#4D7A5B" stroke-width="1.5"/>
            </svg>
            <div class="sidebar-brand-name">
                Postane
                <span class="sidebar-brand-tagline">Kurumsal E-posta</span>
            </div>
        </div>

        <div class="sidebar-compose">
            <a href="/Message/CreateMessage" class="btn-compose">
                <i class="bi bi-pencil-square"></i>
                Yeni Mesaj
            </a>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-heading">Ana Menü</div>
            <ul class="sidebar-menu">
                <li>
                    <a href="/Message/InBox" class="sidebar-link active">
                        <i class="bi bi-inbox"></i>Gelen Kutusu
                        <span class="sidebar-count" id="sidebarUnreadCount">0</span>
                    </a>
                </li>
                <li><a href="/Message/SendBox" class="sidebar-link"><i class="bi bi-send"></i>Gönderilenler</a></li>
            </ul>
        </nav>
    </aside>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="app-main">
        <header class="app-navbar">
            <button type="button" class="icon-btn" id="sidebarToggle" aria-label="Menüyü aç/kapat">
                <i class="bi bi-layout-sidebar"></i>
            </button>

            <form class="navbar-search" role="search" action="#">
                <i class="bi bi-search"></i>
                <input type="search" placeholder="Mesaj, kişi veya dosya ara…" aria-label="Genel arama">
            </form>

            <div class="navbar-actions">
                <span class="navbar-divider"></span>

                <div class="dropdown">
                    <button type="button" class="user-toggle dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="user-avatar">@(User.Identity?.Name?.Substring(0, Math.Min(2, User.Identity.Name.Length)).ToUpper() ?? "KU")</span>
                        <span class="d-none d-md-block">
                            <span class="user-name">@(User.Identity?.Name ?? "Kullanıcı")</span>
                        </span>
                        <i class="bi bi-chevron-down d-none d-md-inline"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <form asp-controller="Login" asp-action="LogOut" method="post" class="m-0">
                                <button type="submit" class="dropdown-item item-logout">
                                    <i class="bi bi-box-arrow-right"></i>Çıkış Yap
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="inbox-container">
            <div class="inbox-header">
                <div>
                    <h1 class="inbox-title">
                        Gelen Kutusu
                        <span class="inbox-stat"><span id="totalCount">0</span> mesaj</span>
                        <span class="inbox-stat is-unread"><span id="unreadCount">0</span> okunmamış</span>
                    </h1>
                    <p class="inbox-subtitle">Gelen mesajlarınızı görüntüleyin ve yönetin.</p>
                </div>
                <span class="inbox-updated"><i class="bi bi-arrow-repeat me-1"></i>Son eşitleme: bugün @DateTime.Now.ToString("HH:mm", tr)</span>
            </div>

            <div class="inbox-filter-bar">
                <div class="inbox-filters" role="tablist">
                    <button type="button" class="inbox-filter active" data-filter="all">
                        Tümü <span class="filter-count" data-count="all">0</span>
                    </button>
                    <button type="button" class="inbox-filter" data-filter="unread">
                        Okunmamış <span class="filter-count" data-count="unread">0</span>
                    </button>
                </div>

                <div class="inbox-search">
                    <i class="bi bi-search"></i>
                    <input type="search" id="inboxSearch" placeholder="Gönderen, konu veya içerikte ara" aria-label="Gelen kutusunda ara">
                </div>
            </div>

            <section class="inbox-panel">
                <div class="inbox-toolbar" id="inboxToolbar">
                    <input class="form-check-input" type="checkbox" id="selectAll" data-bs-toggle="tooltip" data-bs-title="Tümünü seç" aria-label="Tümünü seç">

                    <span class="toolbar-divider"></span>

                    <button type="button" class="icon-btn bulk-action" id="markReadBtn" data-bs-toggle="tooltip" data-bs-title="Okundu olarak işaretle" aria-label="Okundu olarak işaretle">
                        <i class="bi bi-envelope-open"></i>
                    </button>
                    <button type="button" class="icon-btn bulk-action" id="markUnreadBtn" data-bs-toggle="tooltip" data-bs-title="Okunmadı olarak işaretle" aria-label="Okunmadı olarak işaretle">
                        <i class="bi bi-envelope"></i>
                    </button>
                    <button type="button" class="icon-btn bulk-action" id="deleteBtn" data-bs-toggle="tooltip" data-bs-title="Sil" aria-label="Sil">
                        <i class="bi bi-trash3"></i>
                    </button>

                    <span class="toolbar-divider"></span>

                    <a asp-action="InBox" class="icon-btn" id="refreshBtn" data-bs-toggle="tooltip" data-bs-title="Yenile" aria-label="Yenile">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>

                    <span class="selection-info" id="selectionInfo"></span>
                </div>

                <ul class="mail-list" id="mailList">
                    @if (Model != null)
                    {
                        foreach (var mail in Model)
                        {
                            var sender = mail.SenderEmail ?? "Bilinmeyen";
                            var initials = sender.Length >= 2 ? sender.Substring(0, 2).ToUpper(tr) : sender.ToUpper(tr);

                            <li class="mail-item" data-read="@(mail.IsRead ? "true" : "false")">
                                <label class="mail-select">
                                    <input class="form-check-input mail-check" type="checkbox" aria-label="Mesajı seç">
                                </label>
                                <span class="mail-avatar">@initials</span>
                                <span class="mail-sender">@sender</span>
                                <a href="#" class="mail-body">
                                    <span class="mail-subject">@mail.Subject</span>
                                    <span class="mail-preview">@mail.MessageDetail</span>
                                </a>
                                <span class="mail-meta">
                                    <time class="mail-date">@mail.SendDate.ToString("dd MMM", tr)</time>
                                </span>
                            </li>
                        }
                    }
                </ul>

                <div class="mail-empty" id="mailEmpty" @(Model == null || Model.Count == 0 ? "" : "hidden")>
                    <i class="bi bi-inbox"></i>
                    <strong>Mesaj bulunamadı</strong>
                    Gelen kutunuzda henüz mesaj yok.
                </div>

                <div class="inbox-footer">
                    <span>Bu klasörde <span id="footerTotal">@(Model?.Count ?? 0)</span> mesaj bulunuyor.</span>
                    <span class="d-none d-sm-inline">Mesajlar 30 gün sonra arşive taşınır.</span>
                </div>
            </section>
        </main>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body p-4">
                    <h2 class="modal-title mb-2" id="deleteModalTitle">Mesajlar silinsin mi?</h2>
                    <p class="mb-0 text-secondary" style="font-size: 14px;">
                        Seçili <strong id="deleteCount">0</strong> mesaj listeden kaldırılacak.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-app btn-app-light" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" class="btn btn-app btn-app-danger" id="confirmDeleteBtn">Sil</button>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast app-toast" id="appToast" role="status" aria-live="polite">
            <div class="toast-body d-flex align-items-center gap-2">
                <i class="bi bi-check-circle"></i>
                <span id="appToastText"></span>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const mailList = document.getElementById('mailList');
        const selectAll = document.getElementById('selectAll');
        const inboxSearch = document.getElementById('inboxSearch');
        const inboxToolbar = document.getElementById('inboxToolbar');
        const selectionInfo = document.getElementById('selectionInfo');
        const mailEmpty = document.getElementById('mailEmpty');

        let activeFilter = 'all';

        function getAllMails() {
            return Array.from(mailList.querySelectorAll('.mail-item'));
        }
        function getVisibleMails() {
            return getAllMails().filter(mail => !mail.hidden);
        }
        function getSelectedMails() {
            return getAllMails().filter(mail => mail.querySelector('.mail-check').checked);
        }

        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));

        document.getElementById('sidebarToggle').addEventListener('click', function () {
            if (window.innerWidth < 992) {
                document.body.classList.toggle('sidebar-open');
            } else {
                document.body.classList.toggle('sidebar-collapsed');
            }
        });

        document.getElementById('sidebarBackdrop').addEventListener('click', function () {
            document.body.classList.remove('sidebar-open');
        });

        function updateCounts() {
            const mails = getAllMails();
            const total = mails.length;
            const unread = mails.filter(m => m.dataset.read === 'false').length;

            document.getElementById('totalCount').textContent = total;
            document.getElementById('footerTotal').textContent = total;
            document.getElementById('unreadCount').textContent = unread;
            document.getElementById('sidebarUnreadCount').textContent = unread;

            document.querySelector('[data-count="all"]').textContent = total;
            document.querySelector('[data-count="unread"]').textContent = unread;
        }

        function applyFilters() {
            const term = inboxSearch.value.trim().toLocaleLowerCase('tr');
            let visibleCount = 0;

            getAllMails().forEach(function (mail) {
                let matchesFilter = true;
                if (activeFilter === 'unread') matchesFilter = mail.dataset.read === 'false';

                const text = (
                    mail.querySelector('.mail-sender').textContent + ' ' +
                    mail.querySelector('.mail-subject').textContent + ' ' +
                    mail.querySelector('.mail-preview').textContent
                ).toLocaleLowerCase('tr');
                const matchesSearch = text.includes(term);

                mail.hidden = !(matchesFilter && matchesSearch);
                if (!mail.hidden) visibleCount++;
            });

            mailEmpty.hidden = visibleCount > 0;
            updateSelection();
        }

        document.querySelectorAll('.inbox-filter').forEach(function (button) {
            button.addEventListener('click', function () {
                document.querySelectorAll('.inbox-filter').forEach(b => b.classList.remove('active'));
                button.classList.add('active');
                activeFilter = button.dataset.filter;
                applyFilters();
            });
        });

        inboxSearch.addEventListener('input', applyFilters);

        function updateSelection() {
            const visible = getVisibleMails();
            const selected = getSelectedMails();

            getAllMails().forEach(function (mail) {
                mail.classList.toggle('is-selected', mail.querySelector('.mail-check').checked);
            });

            const allVisibleSelected = visible.length > 0 &&
                visible.every(mail => mail.querySelector('.mail-check').checked);

            selectAll.checked = allVisibleSelected;
            selectAll.indeterminate = selected.length > 0 && !allVisibleSelected;

            inboxToolbar.classList.toggle('has-selection', selected.length > 0);
            selectionInfo.textContent = selected.length > 0 ? selected.length + ' mesaj seçildi' : '';
        }

        selectAll.addEventListener('change', function () {
            getVisibleMails().forEach(function (mail) {
                mail.querySelector('.mail-check').checked = selectAll.checked;
            });
            updateSelection();
        });

        mailList.addEventListener('change', function (event) {
            if (event.target.classList.contains('mail-check')) updateSelection();
        });

        mailList.addEventListener('click', function (event) {
            const mail = event.target.closest('.mail-item');
            if (!mail) return;

            if (event.target.closest('.mail-body')) {
                event.preventDefault();
                mail.dataset.read = 'true';
                updateCounts();
                applyFilters();
            }
        });

        function setReadState(isRead) {
            const selected = getSelectedMails();
            if (selected.length === 0) return;

            selected.forEach(function (mail) {
                mail.dataset.read = isRead ? 'true' : 'false';
                mail.querySelector('.mail-check').checked = false;
            });
            updateCounts();
            applyFilters();
        }

        document.getElementById('markReadBtn').addEventListener('click', () => setReadState(true));
        document.getElementById('markUnreadBtn').addEventListener('click', () => setReadState(false));

        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const appToast = new bootstrap.Toast(document.getElementById('appToast'), { delay: 2500 });

        function showToast(message) {
            document.getElementById('appToastText').textContent = message;
            appToast.show();
        }

        document.getElementById('deleteBtn').addEventListener('click', function () {
            const count = getSelectedMails().length;
            if (count === 0) return;
            document.getElementById('deleteCount').textContent = count;
            deleteModal.show();
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            const selected = getSelectedMails();
            selected.forEach(mail => mail.remove());
            deleteModal.hide();
            updateCounts();
            applyFilters();
            showToast(selected.length + ' mesaj listeden kaldırıldı.');
        });

        updateCounts();
    </script>
</body>
</html>